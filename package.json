{
  "name": "harpernet.org",
  "version": "1.9.11",
  "description": "This page is intended to give you some wisdom and a good, hopefully insightful overview into Jungian psychology and the MBTI framework. Maybe something you haven't yet considered.",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "make:og": "node tools/make-og.cjs",
    "build": "vite build",
    "rebuild": "npm run build && npm run pm2:restart",
    "preview": "vite preview",
    "serve": "vite preview --host",
    "start": "npm run pm2:start",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop harpernet-org",
    "pm2:restart": "pm2 restart harpernet-org --update-env",
    "pm2:reload": "pm2 reload harpernet-org --update-env",
    "pm2:delete": "pm2 delete harpernet-org",
    "pm2:status": "pm2 status harpernet-org",
    "pm2:logs": "pm2 logs harpernet-org",
    "pm2:flush": "pm2 flush harpernet-org",
    "pm2:save": "pm2 save",
    "watch": "nodemon --watch src --exec \"npm run dev\" --ext js,jsx,css,html",
    "debug": "vite --debug --host",
    "bump": "npm version patch",
    "prepare": "husky",
    "format": "prettier --write .",
    "weights": "node tools/examine-weights.js > weights.txt",
    "weights:out": "node tools/examine-weights.js > weights.txt && cat weights.txt",
    "weights:out:win": "node tools/examine-weights.js > weights.txt && Get-Content weights.txt"
  },
  "keywords": [
    "mbti",
    "personality",
    "psychology",
    "jung",
    "metabolic principles",
    "personality",
    "test",
    "personality test",
    "unconvential",
    "differential psychology",
    "neurology",
    "evidence based",
    "faithful"
  ],
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "dotenv": "^17.2.1",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "sharp": "^0.34.3",
    "vite": "^6.3.5",
    "vite-plugin-solid": "^2.11.8"
  },
  "author": "soulwax@github",
  "license": "GPL-3.0",
  "homepage": "harpernet.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/soulwax/harpernet.org.git"
  },
  "technology": "Solid.JS",
  "technologyHomepage": "https://solidjs.com",
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
